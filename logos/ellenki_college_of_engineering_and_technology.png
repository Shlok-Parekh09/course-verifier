		function just_ask_validation44(){
		if($("#jsut_ask_form44").length > 0)
		{
			$("#jsut_ask_form44").validate({
				rules: {
	
					name: {
					  required: true,
					},
					location: {
					  required: true,
					},
					email: {
					  required: true,
					 email: true
					},
					mobile_country_code: {
						required: true,
					},
					mobile: {
						required: true,
						number: true,
						minlength:7,
						maxlength:13,
					},
					sub_category_id:{
						required: true,
					},
					 adminssion_1:{
						required: true,
					},
					annual_fees:{
						required: true,
					},
					adminssion_2:{
						required: true,
					},
				 },
				submitHandler: function(form)
				{
					just_inquiry44();
				}
			});
		}
	}
